<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OctoType.MVVM.Views.TypingLauncherView"
             xmlns:vm="clr-namespace:OctoType.ViewModels.TypingLauncher;assembly=OctoType.ViewModels"
             Title="TypingLauncherView"
             x:DataType="vm:TypingLauncherViewModel"
             Shell.NavBarIsVisible="False"
             StyleClass="xylotype_page_bg"
             x:Name="RootPage">

    <Grid
        RowDefinitions="auto,*"
        ColumnDefinitions="*,*"
        ColumnSpacing="20"
        Margin="10,5"
        Padding="5"
        RowSpacing="5">

        <!--settings-->
        <Grid Grid.Row="0"
              Grid.Column="1">

            <HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="End">
                
            <Button Grid.Row="1"
                    Padding="0"
                    Command="{Binding ChangeThemeCommand}"
                    StyleClass="ButtonHoverAddExercice"
                    CornerRadius="20"
                    WidthRequest="100"
                    HeightRequest="20"> 
                <Button.ImageSource>
                    <FontImageSource FontFamily="icones_themes"
                         Glyph="{Binding IconeTheme}"
                         Size="20"/>
                </Button.ImageSource>
            </Button>
            </HorizontalStackLayout>
        </Grid>

        
        <Border Grid.Row="1"
                Grid.Column="1"
                StyleClass="BorderBgStd, BorderTypingRounded10"
                Padding="10">

            <Grid>

                <Label IsVisible="{Binding IsNoSelection}" 
                    Text="Select an exercice on the left"
                       WidthRequest="200"
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>


                <VerticalStackLayout IsVisible="{Binding IsSelectedExercice}">
                    <Label Text="{Binding ExerciceName}" FontSize="34" FontAttributes="Bold" Margin="5,5,0,15" />

                    <Border StyleClass="BorderRounded10, BorderBgDescription" Padding="10" Margin="0,0,0,30">
                        <VerticalStackLayout>
                            <Label Text="Description:" TextColor="White" FontSize="12" Margin="0,0,0,10" />
                            <Label Text="{Binding ExerciceDescription}" TextColor="White" MinimumHeightRequest="50" />
                        </VerticalStackLayout>
                    </Border>

                    <Border StyleClass="BorderRounded10, BorderBgDescription" Padding="10" Margin="0,0,0,30">
                        <VerticalStackLayout>
                            <Label Text="Lettres:" TextColor="White" FontSize="12" Margin="0,0,0,10" />
                            <Label Text="{Binding ExerciceLetters}" TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <Border StyleClass="BorderRounded10, BorderBgDescription" Padding="10">
                        <Grid ColumnDefinitions="auto,*">
                            <Label Text="Nombre de mot" TextColor="White" Margin="0,0,0,0" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" BackgroundColor="#444" TextColor="White" Margin="10,0,0,0" />
                        </Grid>
                    </Border>


                    <Button HorizontalOptions="End" MinimumWidthRequest="70" MaximumWidthRequest="200" Text="Lancer !"
                            Command="{Binding LaunchCommand}"
                            StyleClass="ButtonHoverLaunch"
                            HeightRequest="90"
                            FontSize="20"
                            Margin="10,40,50,10" />


                </VerticalStackLayout>
            </Grid>
        </Border>


        <Border 
            Grid.Row="1"
            Grid.Column="0"
                StyleClass="BorderBgStd, BorderTypingRounded10"
                Padding="10">


            <Grid RowDefinitions="auto,*, 0.15*">
                
                <Grid RowDefinitions="*,*">

                    <Label Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="Exercices !"
                       FontSize="34"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>

                    <Border Grid.Row="1" StyleClass="BorderRounded10, BorderBgDescription" Padding="10">
                        <Grid ColumnDefinitions="auto,*"
                              RowDefinitions="*,auto">
                            <Label Text="Type de clavier" TextColor="White" Margin="0,0,0,0" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" ItemsSource="{Binding KeyboardLayoutAvailable}" SelectedItem="{Binding KeyboardLayoutSelected}" 
                                TextColor="white"
                                BackgroundColor="#444"
                                Margin="10,0,0,0"
                                VerticalTextAlignment="Center"/>

                            
                        </Grid>
                    </Border>
                </Grid>


                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Always">
                    <Grid >
                        <Label Text="Ajoutez des exercices !"
                           TextColor="White"
                           IsVisible="{Binding HasNoExercice}"
 
                           WidthRequest="400"
                           HeightRequest="400"/>

                        <FlexLayout Wrap="Wrap"
                            IsVisible="{Binding HasExercice}"
                            Direction="Row"
                            AlignContent="Start"
                            Padding="5"
                            BindableLayout.ItemsSource="{Binding AllExercice}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExerciceItemViewModel">
                                    <Border HeightRequest="120" WidthRequest="120"
                                            StyleClass="BorderBgBlue,BorderRounded10,BorderHoverLaunch"
                                            Margin="5,5,0,0">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding BindingContext.SelectCommand, Source={x:Reference RootPage}}"
                                                CommandParameter="{Binding .}"/>

                                        </Border.GestureRecognizers>

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor" Value="#FF2000"/>
                                                <Setter Property="StrokeThickness" Value="2" />
                                                <Setter Property="Stroke" Value="#FF5500" />
                                                <Setter Property="Scale" Value="1.05" />


                                                <Setter Property="VisualStateManager.VisualStateGroups">

                                                    <VisualStateGroupList>

                                                        <VisualStateGroup Name="CommonStates">

                                                            <VisualState Name="Normal">
                                                                <VisualState.Setters>
                                                                    <Setter Property="BackgroundColor" Value="#FF2000" />
                                                                </VisualState.Setters>
                                                            </VisualState>

                                                            <VisualState Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Property="BackgroundColor" Value="#FF5500" />
                                                                </VisualState.Setters>
                                                            </VisualState>

                                                        </VisualStateGroup>

                                                    </VisualStateGroupList>

                                                </Setter>
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Grid RowDefinitions="auto,auto,auto">

                                            <Label Grid.Row="0" Text="{Binding Name}" 
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   FontSize="17"
                                                   Margin="0,0,0,15"/>

                                            <Label Grid.Row="1" Text="{Binding Letters}" 
                                                   FontSize="10"
                                                   Margin="10,0"/>

                                            <Border Grid.Row="2"
                                                IsVisible="{Binding IsDynamic}"
                                                StrokeShape="RoundRectangle 6" HorizontalOptions="End"
                                                Padding="5,0,5,2" Margin="0,10,5,0">

                                                <Label Text="{Binding TextType}" HorizontalOptions="End"
                                                       VerticalOptions="End"
                                                        FontSize="12" TextColor="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </FlexLayout>
                    </Grid>
                </ScrollView>

                <Button Grid.Row="2"
                    Text="+" CornerRadius="30" HeightRequest="60" WidthRequest="60"
                        StyleClass="ButtonHoverAddExercice"
                        
                        FontSize="35"
                        VerticalOptions="Center" HorizontalOptions="End"
                        Margin="0,0,60,0"
                        Command="{Binding GoToExerciceGeneratorCommand}"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>