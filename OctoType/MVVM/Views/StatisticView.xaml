<ContentPage x:Class="OctoType.MVVM.Views.StatisticView"
             xmlns:vm ="clr-namespace:OctoType.MVVM.ViewModels"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:DataType="vm:StatisticViewModelMauiAdapter"
             Title="StatisticView"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             StyleClass="xylotype_page_bg">

    <VerticalStackLayout>
        <Label Text="Statistics"
               FontSize="45"
               Margin="20,10,0,0"
               />

        <Border Margin="30,30"
            StyleClass="BorderTypingRounded10, BorderBgTyping"
                Padding="10">

            <Grid ColumnDefinitions="*,*">

                <Grid Grid.Column="0"
                      HorizontalOptions="Center"
                    ColumnDefinitions="auto,*">

                    <Label Grid.Column="1" 
                        Text="WPM"
                        Margin="10"
                        FontSize="25"
                        VerticalOptions="Center"/>

                    <Label Grid.Column="0" 
                        Text="{Binding WordsPerMinuteText}"
                        Margin="10,0"
                        FontSize="30"
                           VerticalOptions="Center"
                        TextColor="DarkSlateGray"/>
                </Grid>

                <Grid Grid.Column="1"
                      HorizontalOptions="Center"
                    ColumnDefinitions="auto,*">

                    <Label Grid.Column="1" 
                        Text="LPM"
                        Margin="10,0"
                        FontSize="25"
                           VerticalOptions="Center"/>

                    <Label Grid.Column="0" 
                        Text="{Binding LetterPerMinuteText}"
                        Margin="10"
                        FontSize="30"
                        TextColor="DarkSlateGray"
                           VerticalOptions="Center"/>
                </Grid>
            </Grid>
        </Border>

        <Border Margin="30,30"
                StyleClass="BorderTypingRounded10, BorderBgTyping"
                Padding="20, 10,20,40">

            <Grid RowDefinitions="*,*,*">
                <Label Grid.Row="0"
                    Text="Response time(s)"
                       Margin="10,0"
                       FontSize="30"/>

                <Label Grid.Row="1"
                        Text="The less, the better"
                        Margin="10"
                        FontSize="15"
                        TextColor="DarkSlateGray"/>

                <micro:ChartView  Grid.Row="2" 
                            Chart="{Binding TheChart}" 
                             HeightRequest="300"
                             WidthRequest="800"
                             />
            </Grid>
        </Border>

    </VerticalStackLayout>

</ContentPage>