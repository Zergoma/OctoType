<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OctoType.MVVM.Views.ImportBookView"
             xmlns:vm="clr-namespace:OctoType.MVVM.ViewModels"
             Title="Import Book"
             x:DataType="vm:ImportBookViewModel">
    
    
    <Grid RowDefinitions="0.2*,0.8*"
      HorizontalOptions="Fill"
      VerticalOptions="Fill">

        <Label Grid.Row="0"
        Text="Import mots"
        FontSize="Large"
        VerticalOptions="Center" 
        HorizontalOptions="Center" />

        <Grid Grid.Row="1"
        RowDefinitions="*,*,*"
          ColumnDefinitions="*,*"
          VerticalOptions="Center"
          HorizontalOptions="Center"
          RowSpacing="10"
          Margin="10">

            <Button Text="Sélection d'un livre"
                Command="{Binding SelectFileCommand}"
            Grid.Row="0"/>

            <Button Text="Importer"
            Grid.Column="1"
            Grid.Row="2"
            FontSize="24"
            FontAttributes="Bold"
            CornerRadius="20"
            IsEnabled="{Binding IsFileSelected}"
            Command="{Binding ImportFileCommand}"
                />
        </Grid>
    </Grid>
</ContentPage>